{
  "name": "akim-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests eslint.config.mjs vitest.config.ts playwright.config.ts next.config.ts postcss.config.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --configLoader runner && npm run test:engine",
    "test:engine": "node --experimental-strip-types --test tests/simulation/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "^15.5.12",
    "openai": "^5.20.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.16",
    "@types/node": "^22.18.12",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.39.0",
    "eslint-config-next": "^15.5.12",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
