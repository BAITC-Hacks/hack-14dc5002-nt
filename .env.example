# Server-only. Never use NEXT_PUBLIC_ for secrets. Do not commit .env.local.
OPENAI_API_KEY=
# Set to a model actually available to your project and supporting Structured Outputs.
OPENAI_MODEL=
AI_ENABLED=false
AI_TIMEOUT_MS=12000
# Explicit local AI opt-in; only use with npm run dev:local (loopback binding).
# Ignored in production. Keep false for offline development/tests.
AI_LOCAL_DEMO=false
# Server-only gateway credential for protected non-local calls. Never expose in client JS.
# Missing/invalid authorization returns a template; public production AI is not enabled.
EXPLAIN_AI_ACCESS_TOKEN=
# Public non-secret flag. Set to false for integration and final demo.
NEXT_PUBLIC_USE_MOCK_API=true
