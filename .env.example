# Server-only. Never use NEXT_PUBLIC_ for secrets. Do not commit .env.local.
OPENAI_API_KEY=
# Set to a model actually available to your project and supporting Structured Outputs.
OPENAI_MODEL=
AI_ENABLED=false
AI_TIMEOUT_MS=12000
# Public non-secret flag. Set to false for integration and final demo.
NEXT_PUBLIC_USE_MOCK_API=true
